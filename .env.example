# リタスの外部の宛先（src/config/endpoints.ts）。このファイルを .env に写して値を入れる（.env は git 外）。
# 未設定・空のまま焼くと、その機能は無い扱いになる（通信もしない・入口も出さない）。
# 提供者の配る production ビルドでは6つすべて必須＝焼く前に `node scripts/check-release-env.mjs` を叩く。
# ⚠ EXPO_PUBLIC_* はビルド時に JS へ埋め込まれ、配布物から読める（秘密を書かない）。

# ビルド種別（dev / beta / production）。production のときだけ下の6つを検査する。
EXPO_PUBLIC_RELEASE_STAGE=

# 停止指示ファイル status.json の URL（キルスイッチ。未設定ならキルスイッチ自体が無い）。
EXPO_PUBLIC_KILLSWITCH_URL=
# フィードバックの送信先 API の URL（未設定なら送信しない）。
EXPO_PUBLIC_FEEDBACK_URL=
# 紹介ページの URL（停止画面・お知らせ帯の脱出先と「友だちに教える」の共有文。未設定ならそれらの入口を出さない）。
EXPO_PUBLIC_SITE_URL=
# 連絡先メールアドレス（フィードバック送信失敗時の mailto。未設定なら mailto と宛先の文言を出さない）。
EXPO_PUBLIC_CONTACT_EMAIL=
# App Store の評価ページの URL（例: https://apps.apple.com/jp/app/id<数字>?action=write-review）。
EXPO_PUBLIC_IOS_REVIEW_URL=
# Google Play の評価ページの URL（例: https://play.google.com/store/apps/details?id=<パッケージ名>）。
EXPO_PUBLIC_ANDROID_REVIEW_URL=
